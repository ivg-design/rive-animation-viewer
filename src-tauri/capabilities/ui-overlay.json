{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui-overlay-capability",
  "description": "A narrow intent channel for bounded native UI overlay WebViews.",
  "webviews": [
    "ui-overlay-*"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-ui-overlay-ready",
    "allow-submit-ui-overlay-action"
  ]
}
