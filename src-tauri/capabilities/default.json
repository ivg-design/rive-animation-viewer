{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Main desktop capability for the Rive Animation Viewer window.",
  "webviews": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "process:default",
    "updater:default",
    "allow-make-demo-bundle",
    "allow-make-demo-bundle-to-path",
    "allow-open-isolated-playback",
    "allow-get-install-counter-status",
    "allow-set-install-counter-enabled",
    "allow-acknowledge-install-counter-notice",
    "allow-complete-telemetry-acceptance-action",
    "allow-get-riv-default-app-status",
    "allow-make-rav-default-for-riv",
    "allow-get-mcp-server-path",
    "allow-get-mcp-port",
    "allow-set-mcp-port",
    "allow-stop-mcp-bridge",
    "allow-get-mcp-setup-status",
    "allow-install-mcp-client",
    "allow-remove-mcp-client",
    "allow-detect-node-runtime",
    "allow-create-render-surface",
    "allow-set-render-surface-bounds",
    "allow-show-render-surface",
    "allow-hide-render-surface",
    "allow-park-render-surface",
    "allow-restore-render-surface",
    "allow-close-render-surface",
    "allow-activate-render-surface",
    "allow-discard-render-surface",
    "allow-send-render-surface-message",
    "allow-show-ui-overlay",
    "allow-restack-ui-overlay",
    "allow-update-ui-overlay-state",
    "allow-close-ui-overlay",
    "allow-acknowledge-ui-overlay-adopted",
    "allow-complete-ui-overlay-action",
    "allow-is-ui-overlay-supported",
    "allow-check-for-app-update",
    "allow-get-updater-acceptance-config",
    "allow-install-app-update",
    "allow-relaunch-app",
    "allow-open-devtools",
    "allow-open-external-url",
    "allow-pick-image-file",
    "allow-pick-riv-file",
    "allow-get-rav-operational-trace",
    "allow-clear-rav-operational-trace",
    "allow-get-opened-file",
    "allow-read-riv-file",
    "allow-media-export-capabilities",
    "allow-media-export-choose-path",
    "allow-media-export-begin",
    "allow-media-export-frame",
    "allow-media-export-finish",
    "allow-media-export-status",
    "allow-media-export-cancel",
    "allow-media-export-abort"
  ]
}
