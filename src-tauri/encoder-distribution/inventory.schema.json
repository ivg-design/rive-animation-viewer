{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rav.dev/schemas/encoder-distribution-inventory-v1.json",
  "title": "RAV production encoder distribution inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "distribution", "binaries"],
  "properties": {
    "schema_version": { "const": 1 },
    "distribution": { "$ref": "#/$defs/distribution" },
    "binaries": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/binary" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))(?!.*\\\\).+$"
    },
    "plainFile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    },
    "integrityFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "file", "sha256", "size_bytes"],
      "properties": {
        "source_file": { "$ref": "#/$defs/relativePath" },
        "file": { "$ref": "#/$defs/relativePath" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 16777216 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "redistribution_approved",
        "approved_by",
        "approved_at",
        "review_reference",
        "signing_required"
      ],
      "properties": {
        "redistribution_approved": { "const": true },
        "approved_by": { "type": "string", "minLength": 3 },
        "approved_at": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*Z)?$"
        },
        "review_reference": { "type": "string", "minLength": 3 },
        "signing_required": { "const": true }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "provenance_summary", "approval"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "target": {
          "enum": [
            "macos-aarch64",
            "macos-x86_64",
            "linux-aarch64",
            "linux-x86_64",
            "windows-aarch64",
            "windows-x86_64"
          ]
        },
        "provenance_summary": { "type": "string", "minLength": 3 },
        "approval": { "$ref": "#/$defs/approval" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "artifact_url",
        "artifact_sha256",
        "source_code_url",
        "source_code_sha256"
      ],
      "properties": {
        "kind": {
          "enum": ["upstream_release", "vendor_supplied", "self_built_from_upstream"]
        },
        "artifact_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "source_code_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "source_code_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "notice_files", "redistribution_basis", "review_reference"],
      "properties": {
        "spdx": { "type": "string", "minLength": 3 },
        "notice_files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/integrityFile" }
        },
        "redistribution_basis": { "type": "string", "minLength": 3 },
        "review_reference": { "type": "string", "minLength": 3 }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_file",
        "file",
        "sha256",
        "size_bytes",
        "version",
        "source",
        "provenance_file",
        "license"
      ],
      "properties": {
        "id": { "enum": ["ffmpeg", "ffprobe"] },
        "source_file": { "$ref": "#/$defs/relativePath" },
        "file": { "$ref": "#/$defs/plainFile" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size_bytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "version": { "type": "string", "minLength": 3 },
        "source": { "$ref": "#/$defs/source" },
        "provenance_file": { "$ref": "#/$defs/integrityFile" },
        "license": { "$ref": "#/$defs/license" }
      }
    }
  }
}
