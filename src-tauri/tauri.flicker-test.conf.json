{
  "productName": "RAV 2.5.4 DEV",
  "version": "2.5.4",
  "mainBinaryName": "rav-2.5.4-dev",
  "identifier": "app.rive.animation.viewer.flicker-test",
  "build": {
    "beforeBuildCommand": "node scripts/build-dev-dist.mjs && npm run build:mcp",
    "beforeDevCommand": "npm run build:mcp:debug && npm run serve:dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist-dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RAV 2.5.4 DEV",
        "width": 1250,
        "height": 900,
        "minWidth": 1090,
        "minHeight": 850,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#0A0A0AFF",
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false,
    "fileAssociations": [
      {
        "ext": [
          "riv"
        ],
        "name": "Rive File",
        "description": "Rive animation file",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.rive.editor",
        "contentTypes": [
          "app.rive.editor.rive-file",
          "app.rive.riv",
          "com.play.riv",
          "app.rive.animation.viewer.riv"
        ]
      }
    ],
    "macOS": {
      "hardenedRuntime": false,
      "infoPlist": "Info.dev.plist"
    }
  }
}
