{
  "productName": "RAV 2.5.3 DEV",
  "version": "2.5.3",
  "mainBinaryName": "rav-2.5.3-dev",
  "identifier": "app.rive.animation.viewer.flicker-test",
  "build": {
    "beforeBuildCommand": "node scripts/build-dev-dist.mjs && npm run build:mcp",
    "beforeDevCommand": "npm run build:mcp:debug && npm run serve:dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist-dev"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "RAV 2.5.3 DEV",
        "width": 1250,
        "height": 900,
        "minWidth": 1090,
        "minHeight": 850,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#0A0A0AFF",
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "fileAssociations": null,
    "macOS": {
      "hardenedRuntime": false,
      "infoPlist": "Info.dev.plist"
    }
  }
}
