<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RAV consumes the UTI owned by the official Rive editor and keeps its
	     pre-2.4.3 UTI readable during Launch Services migration. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>riv</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
			<!-- Prevent modern Launch Services from replacing the authored
			     document artwork with a generic page plus app badge. -->
			<key>CFBundleTypeIconSystemGenerated</key>
			<false/>
			<key>CFBundleTypeName</key>
			<string>Rive File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.rive.editor.rive-file</string>
				<string>app.rive.riv</string>
				<string>com.play.riv</string>
				<string>app.rive.animation.viewer.riv</string>
			</array>
		</dict>
		<!-- Extension-only fallback. RAV enumerates every registered UTI tagged
		     with .riv at runtime, while this declaration keeps RAV and its document
		     icon eligible for identifiers that did not exist when RAV was built. -->
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>riv</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
			<key>CFBundleTypeIconSystemGenerated</key>
			<false/>
			<key>CFBundleTypeName</key>
			<string>Rive File (extension fallback)</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
	</array>
	<!-- Existing RAV installations exported this identifier. Keep it declared
	     with the new icon and make it conform to the official Rive file UTI so
	     already-indexed .riv files migrate without a generic document badge. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.rive.animation.viewer.riv</string>
			<key>UTTypeDescription</key>
			<string>Rive File (legacy RAV identifier)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>app.rive.editor.rive-file</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
				<key>public.mime-type</key>
				<string>application/octet-stream</string>
			</dict>
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.rive.editor.rive-file</string>
			<key>UTTypeDescription</key>
			<string>Rive File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.rive.editor</string>
			</dict>
			<!-- Dedicated document icon supplied by the product owner. -->
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.rive.riv</string>
			<key>UTTypeDescription</key>
			<string>Rive File (app.rive.riv compatibility)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>app.rive.editor.rive-file</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
			</dict>
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.play.riv</string>
			<key>UTTypeDescription</key>
			<string>Rive File (com.play.riv compatibility)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>app.rive.editor.rive-file</string>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
			</dict>
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
	</array>
</dict>
</plist>
