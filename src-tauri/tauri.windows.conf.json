{
  "bundle": {
    "resources": {
      "icons/RiveFileIcon.ico": "RiveFileIcon.ico"
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/nsis-hooks.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/wix-rive-document-icon.wxs"
        ],
        "componentRefs": [
          "RiveDocumentIconRegistry"
        ]
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rive Animation Viewer",
        "width": 1250,
        "height": 900,
        "minWidth": 1090,
        "minHeight": 850,
        "resizable": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0A0A0AFF",
        "theme": "Dark",
        "transparent": false,
        "titleBarStyle": "Visible",
        "trafficLightPosition": null,
        "hiddenTitle": false,
        "fullscreen": false
      }
    ]
  }
}
