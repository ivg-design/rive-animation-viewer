<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RAV consumes the UTI owned by the official Rive editor. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>riv</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
			<key>CFBundleTypeName</key>
			<string>Rive File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.rive.editor.rive-file</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.rive.editor.rive-file</string>
			<key>UTTypeDescription</key>
			<string>Rive File</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.rive.editor</string>
			</dict>
			<!-- Dedicated document icon supplied by the product owner. -->
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
	</array>
</dict>
</plist>
