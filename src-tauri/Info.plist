<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- RAV owns the desktop .riv playback association. The Rive editor exports
	     .riv files but does not open them, so the viewer declares one canonical
	     UTI instead of importing or conforming to the editor's UTI. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>riv</string>
			</array>
			<key>CFBundleTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
			<!-- Prevent modern Launch Services from replacing the authored
			     document artwork with a generic page plus app badge. -->
			<key>CFBundleTypeIconSystemGenerated</key>
			<false/>
			<key>CFBundleTypeName</key>
			<string>Rive File</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>app.rive.animation.viewer.riv</string>
			</array>
		</dict>
	</array>
	<!-- The exported declaration makes this bundle the UTI owner used by Finder. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>app.rive.animation.viewer.riv</string>
			<key>UTTypeDescription</key>
			<string>Rive Animation</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>riv</string>
				</array>
				<key>public.mime-type</key>
				<string>application/vnd.rive.editor</string>
			</dict>
			<key>UTTypeIconFile</key>
			<string>RiveFileIcon.icns</string>
		</dict>
	</array>
</dict>
</plist>
