{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Rive Animation Viewer",
  "version": "2.5.4",
  "identifier": "app.rive.animation.viewer",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run build:mcp:debug && npm run serve",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main-capability",
        "render-surface-capability",
        "ui-overlay-capability"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Rive Animation Viewer",
        "width": 1250,
        "height": 900,
        "minWidth": 1090,
        "minHeight": 850,
        "resizable": true,
        "decorations": true,
        "shadow": true,
        "backgroundColor": "#0A0A0AFF",
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Rive animation player and runtime debugger",
    "longDescription": "Desktop viewer for Rive files with VM/state machine controls, runtime switching, code injection, event logging, and standalone demo export.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/RiveFileIcon.icns": "RiveFileIcon.icns"
    },
    "macOS": {
      "hardenedRuntime": true,
      "infoPlist": "Info.production.plist"
    },
    "fileAssociations": [
      {
        "ext": [
          "riv"
        ],
        "name": "Rive File",
        "description": "Rive animation file",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/vnd.rive.editor",
      "contentTypes": [
        "app.rive.editor.rive-file",
        "app.rive.riv",
        "com.play.riv",
        "app.rive.animation.viewer.riv"
      ]
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCMTFBRDAxOTY3MzdGQ0UKUldUT2YzT1dBYTBSQ3liSXBYYVlYeExxcEFLaGR5ZmhnZ3JxNjdtVzFRWjhKNFJ4TU83VWh1OCsK",
      "endpoints": [
        "https://github.com/ivg-design/rive-animation-viewer/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
