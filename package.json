{
  "name": "rive-animation-viewer",
  "version": "2.5.3",
  "description": "Desktop and web viewer for .riv files with ViewModel controls, artboard/animation switching, script editor, event console, standalone export, and MCP remote control",
  "main": "index.html",
  "scripts": {
    "start": "node scripts/serve-dev.mjs --port 1420 --open",
    "serve": "node scripts/serve-dev.mjs --port 1420",
    "serve:dev": "node scripts/serve-dev.mjs --port 1421",
    "dev": "node scripts/serve-dev.mjs --port 1420",
    "generate:snippets": "node scripts/generate-snippet-modules.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:deps": "depcruise --config .dependency-cruiser.cjs mcp-server/index.js src/app",
    "test": "npm run generate:snippets && npm run check:architecture && npm run check:deps && vitest run && npm run test:counter",
    "test:counter": "npm --prefix telemetry/worker test",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "test:dual-webview": "vitest run tests/unit/platform/canvas-background-controller.test.js tests/unit/platform/demo-template-vm.test.js tests/unit/platform/global-bindings.test.js tests/unit/platform/mcp-status-playback.test.js tests/unit/platform/render-surface-controller.test.js tests/unit/rive/artboard-switcher.test.js tests/unit/rive/instance-controller.test.js tests/unit/rive/playback-controls.test.js tests/unit/ui/shell-controller.test.js",
    "verify:dual-webview-receipt": "node scripts/verify-dual-webview-receipt.mjs",
    "verify:isolated-dev-mcp-receipt": "node scripts/verify-isolated-dev-mcp-receipt.mjs",
    "test:ui": "npm run test:coverage && node scripts/prepare-vitest-ui-theme.mjs && vitest --ui --coverage.enabled --api.port 51204 --api.host 127.0.0.1 --api.strictPort",
    "test:coverage": "vitest run --coverage && node scripts/theme-coverage-report.mjs",
    "test:coverage:serve": "npm run test:coverage && node scripts/serve-static.mjs coverage 4174 127.0.0.1",
    "prebuild": "npm run test",
    "build:mcp": "node scripts/build-mcp-sidecar.mjs",
    "build:mcp:debug": "node scripts/build-mcp-sidecar.mjs --debug",
    "build": "npm run generate:snippets && node scripts/build-dist.mjs",
    "build:dev:web": "node scripts/build-dev-dist.mjs",
    "build:dev": "tauri build --bundles app --no-sign --config src-tauri/tauri.flicker-test.conf.json",
    "tauri": "tauri",
    "build:full": "npm run build && npm run tauri build",
    "build:updater-bootstrap": "tauri build --bundles app --no-sign --config src-tauri/tauri.acceptance.conf.json",
    "accept:updater": "node scripts/run-updater-acceptance.mjs",
    "sync": "node scripts/sync-version.mjs",
    "verify:updater-signatures": "node scripts/verify-updater-signatures.mjs",
    "verify:updater-staging": "node scripts/updater-staging-ledger.mjs",
    "verify:windows-document-icon": "node scripts/verify-windows-document-icon.mjs"
  },
  "keywords": [
    "rive",
    "animation",
    "viewer",
    "viewmodel",
    "tauri",
    "mcp"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "dependency-cruiser": "^17.3.10",
    "esbuild": "^0.27.0",
    "jsdom": "^26.1.0",
    "vite": "^7.3.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.8",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.2",
    "lucide": "1.34.0"
  }
}
